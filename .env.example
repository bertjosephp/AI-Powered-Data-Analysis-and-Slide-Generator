# ---------- Backend (apps/api) ----------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# Typeface used in generated decks (Aptos ships with current Microsoft Office).
DECK_FONT=Aptos

MAX_UPLOAD_MB=25
PROFILE_SAMPLE_ROWS=200000
JOB_TTL_S=3600
CORS_ORIGINS=http://localhost:3000
# Optional regex for per-deploy origins, e.g. Vercel previews:
# CORS_ORIGIN_REGEX=https://your-project-[a-z0-9-]+\.vercel\.app

# When true, a deterministic mock analyst replaces Claude (offline demo / E2E).
# The deck is still rendered for real.
MOCK_EXTERNAL=false

# Claude pricing used for cost accounting (USD per million tokens; claude-sonnet-5).
LLM_INPUT_USD_PER_MTOK=2
LLM_OUTPUT_USD_PER_MTOK=10

# Public-demo protection (ignored in mock mode). Over a limit, runs use the offline analyst.
DEMO_RUNS_PER_HOUR=3
DAILY_BUDGET_USD=3
MAX_CONCURRENT_ANALYSES=2

# ---------- Frontend (apps/web) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAX_UPLOAD_MB=25

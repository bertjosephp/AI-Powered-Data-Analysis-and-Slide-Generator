# ---------- Backend (apps/api) ----------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# Typeface used in generated decks (Aptos ships with current Microsoft Office).
DECK_FONT=Aptos

MAX_UPLOAD_MB=25
PROFILE_SAMPLE_ROWS=200000
JOB_TTL_S=3600
CORS_ORIGINS=http://localhost:3000

# When true, a deterministic mock analyst replaces Claude (offline demo / E2E).
# The deck is still rendered for real.
MOCK_EXTERNAL=false

# ---------- Frontend (apps/web) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAX_UPLOAD_MB=25

# ---------- Backend (apps/api) ----------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
GAMMA_API_KEY=
GAMMA_BASE_URL=https://public-api.gamma.app/v1.0
GAMMA_TIMEOUT_S=300
GAMMA_POLL_INTERVAL_S=5
# aiGenerated images cost 2-125 credits each; pictographic/noImages/themeAccent are cheap
GAMMA_IMAGE_SOURCE=pictographic

MAX_UPLOAD_MB=25
PROFILE_SAMPLE_ROWS=200000
JOB_TTL_S=3600
CORS_ORIGINS=http://localhost:3000

# When true, the LLM and Gamma stages return fixtures (offline demo / E2E).
MOCK_EXTERNAL=false

# ---------- Frontend (apps/web) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
